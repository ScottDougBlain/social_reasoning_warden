# API keys for LLM providers (in fallback order)
# Set at least one of these. The system will try providers in order until one succeeds.

# Primary: OpenRouter (access to many models including DeepSeek R1)
OPENROUTER_API_KEY=your-openrouter-api-key

# Fallback 1: Groq (fast inference, Llama models)
GROQ_API_KEY=your-groq-api-key

# Fallback 2: Together AI (many open models)
TOGETHER_API_KEY=your-together-api-key

# Fallback 3: Cerebras (fast Llama inference)
CEREBRAS_API_KEY=your-cerebras-api-key

# Fallback 4: Hugging Face Inference API
HF_API_KEY=your-huggingface-api-key
